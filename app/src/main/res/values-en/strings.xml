    <string name="settings_playback_cdn_title">CDN route</string>
    <string name="settings_playback_cdn_description">Switch the CDN node for video streams. Defaults to Bilibili\'s auto allocation; you can manually pick a faster node in peak hours or across networks.</string>
    <string name="settings_youtube_default_quality_title">YouTube default quality</string>
    <string name="settings_youtube_default_quality_description">The quality cap used for new YouTube videos. Auto uses the highest available.</string>
    <string name="settings_youtube_content_region_title">YouTube content region</string>
    <string name="settings_youtube_content_region_description">InnerTube content region/language (gl/hl). Defaults to the US; do not set to China (gl=CN triggers anti-bot). When on a VPN for a different region, let gl follow to avoid IP/region mismatch being flagged as a bot, and see region-local content. Note: the primary SABR path is decided by NewPipe; this mainly affects WEB /player and DASH fallback.</string>
    <string name="settings_default_speed_title">Default playback speed</string>
    <string name="settings_default_speed_description">The playback speed used when starting a new video. You can still adjust it in the menu during playback.</string>
    <string name="settings_playback_buffer_title">Buffer length</string>
    <string name="settings_playback_buffer_description">How long the buffer can hold against network dips. Higher is more resilient but uses more memory; default 50s to match LibreTube. Requires reopening the player after changing.</string>
    <string name="settings_speed_test_title">Network speed test</string>
    <string name="settings_speed_test_description">Tests each CDN node using the last played video to pick a faster route.</string>

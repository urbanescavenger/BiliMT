    <string name="settings_seek_preview_sprites_description">Shows a video preview when seeking fast-forward/rewind; confirm to jump. Off shows only the time.</string>
    <string name="settings_air_jump_assistant_title">Audio jump assistant</string>
    <string name="settings_air_jump_assistant_description">Automatically skips ads and sponsored segments in videos, and marks skip ranges on the progress bar.</string>
    <string name="settings_confirm_playback_exit_title">Confirm exit on second back</string>
    <string name="settings_confirm_playback_exit_description">When enabled, the first Back press only shows a hint; pressing again within 3s exits playback.</string>
    <string name="settings_auto_play_next_episode_title">Auto-continue next part</string>
    <string name="settings_auto_play_next_episode_description">Plays the next part automatically after a multi-part video ends.</string>
    <string name="settings_auto_play_related_video_title">Auto-play recommended next</string>
    <string name="settings_auto_play_related_video_description">When there is no next part, plays the first recommended video.</string>
    <string name="settings_auto_return_home_on_completion_title">Exit playback when done</string>
    <string name="settings_auto_return_home_on_completion_description">When there is nothing left to play, returns to the previous page and restores video focus.</string>
    <string name="settings_interaction_section">UI/UX</string>
    <string name="settings_show_clock_title">Show clock</string>
    <string name="settings_show_clock_description">Shows the current time in the top-right of the player.</string>
    <string name="settings_show_mini_progress_bar_title">Show mini progress bar</string>
    <string name="settings_show_mini_progress_bar_description">Controls whether the thin bottom progress bar stays visible during playback.</string>
    <string name="settings_player_log_overlay_title">Player log overlay</string>
    <string name="settings_player_log_overlay_description">Overlays live logs on the picture when PGC is black-screening for direct debugging. Diagnostic only.</string>
    <string name="settings_auto_confirm_on_focus_title">Auto-confirm on focus</string>
    <string name="settings_auto_confirm_on_focus_description">When on, moving focus onto a navigation or home section tab enters it automatically; when off, press confirm. First entry or empty content still auto-loads.</string>
    <string name="settings_auto_refresh_on_switch_title">Auto-refresh on switch</string>
    <string name="settings_auto_refresh_on_switch_description">Depends on auto-confirm. When on, re-fetches data on switch; when off, keeps existing content and refreshes when switching with confirm.</string>

#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""TVBox 源分层测活引擎（Part B / B1，设计见 docs/tvbox-source-aggregator-design.md §5）。

口径唯一（2026-11-20 用户拍板）：**校验出的 healthy 源，用本仓库 TvboxRepository
播放方法必须可播**。只测 type 0/1 采集站（本仓库 config 只收这类）：

  `?ac=detail&wd=<热词>` 一步取址 → parseEpisodeList 选集规则（$$$ 分组、
  含 m3u8 组优先、剔官方播放页）→ 随机一条 → resolveLineUrl 三级提取
  （const url / 绝对 m3u8 / 相对 resolve + 红果 main_url 分支）→ 试播
  拉通 m3u8+首分片 256KB（裸头）。超时 8s 近似本仓库 5 连/8 读。

不测的（本仓库模块播不了，测通了也进不了清单）：
  * type 3 蜘蛛（含 52 个 B 站类 csp_Bili*，本仓库 config 直接过滤）——
    untestable 不判死；searchable=0 —— 跳过不测。
  （原 B 站类 BV 单独路径已砍：BV 测通 ≠ 本仓库可播，会把不可播源洗进
    recommended，与口径矛盾。）

状态机（对接 aggregate.py 的 state/checks.json）：
  healthy=L3 试播通（streak 清零）/ degraded=L1L2 过但试播或线路解析失败 /
  unknown=L0 类失败未满 3 次 / dead=连续 3 次 L0 / untestable=不测的类型。
  连接层失败（超时/拒绝/SSL）单次不判死：保持原 status，只记 reason，不计 streak。

结果主存 op（默认 /etc/tvboxcheck/checks.json），回传仓库是可选动作。
仅标准库（Python >= 3.11 不需要，3.8+ 即可跑）。
"""

import argparse
import json
import random
import re
import ssl
import sys
import time
import traceback
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_INPUT = ("https://raw.githubusercontent.com/urbanescavenger/BiliMT/"
                 "main/tools/tvbox/dist/tvbox.json")
DEFAULT_OUTPUT = "/etc/tvboxcheck/checks.json"
SEGMENT_BYTES = 256 * 1024
PLAYLIST_BYTES = 512 * 1024
FRESH_MS = 6 * 60 * 1000        # 6 小时内测过的站默认跳过（--full 忽略）
STRIKE_LIMIT = 3                # 连续 3 次 L0 判死

# 与本仓库 TvboxRepository 同款热词池（等价用户输关键词搜索）
HOTWORDS = ["斗罗大陆", "庆余年", "狂飙", "三体", "医生", "凡人修仙传", "莲花楼"]

# 与 TvboxRepository.OFFICIAL_PLAYER_HOSTS 同款：JS 播放页，提取不到直链
OFFICIAL_PLAYER_HOSTS = [
    "://v.qq.com/", "://m.v.qq.com/", ".iqiyi.com/", ".youku.com/",
    ".mgtv.com/", ".bilibili.com/", ".sohu.com/", ".1905.com/",
    ".pptv.com/", ".le.com/", ".letv.com/",
]

# 与 TvboxRepository 提取正则同款
CONST_URL_REGEX = re.compile(r'const url\s*=\s*"([^"]+)"')
M3U8_URL_REGEX = re.compile(r'https?://[^"\'\s<>]+\.m3u8[^"\'\s<>]*')
RELATIVE_M3U8_REGEX = re.compile(r'["\'](/[^"\'\s<>]+\.m3u8[^"\'\s<>]*)["\']')
HONGGUO_MAIN_URL_REGEX = re.compile(r'"main_url":"(.*?)"')

_SSL_CONTEXT = None
_SSL_CHECKED = False


class NetworkError(Exception):
    """连接层失败（超时/拒绝/SSL）：单次不判死。"""


def _ssl_context():
    """系统没有 CA 包时（OpenWrt/Windows/conda 常见）退回 certifi。"""
    global _SSL_CONTEXT, _SSL_CHECKED
    if _SSL_CHECKED:
        return _SSL_CONTEXT
    _SSL_CHECKED = True
    try:
        paths = ssl.get_default_verify_paths()
        if paths.cafile:
            import os
            if os.path.exists(paths.cafile):
                return None
    except Exception:
        pass
    try:
        import certifi
    except ImportError:
        return None
    _SSL_CONTEXT = ssl.create_default_context(cafile=certifi.where())
    return _SSL_CONTEXT


def normalize_url(url):
    """IRI → URI：非 ASCII 的 host 做 idna、路径/参数做百分号编码。

    http.client 对 host 和请求行都只认 latin-1——中文/西里尔域名或中文路径
    直接进请求会抛 UnicodeEncodeError（真机日志 'latin-1 codec can't encode
    characters in position 2-3'，position 2-3 正是 c.西里尔.icu 的域名段）。
    已有的 %xx 不动（safe 含 %），不双重编码。
    """
    try:
        parts = urllib.parse.urlsplit(url)
        netloc = parts.netloc
        host = parts.hostname
        if host and not host.isascii():
            idna = host.encode("idna").decode("ascii")
            userinfo = ""
            if parts.username:
                userinfo = parts.username
                if parts.password:
                    userinfo += ":" + parts.password
                userinfo += "@"
            port = (":" + str(parts.port)) if parts.port else ""
            netloc = userinfo + idna + port
        path = urllib.parse.quote(parts.path, safe="/%:@!$&'()*+,;=-._~")
        query = urllib.parse.quote(parts.query, safe="=&%+/?:@!$'()*,;~-._")
        fragment = urllib.parse.quote(parts.fragment, safe="/%?:@!$&'()*+,;=-._~")
        return urllib.parse.urlunsplit(
            (parts.scheme, netloc, path, query, fragment))
    except Exception:
        return url


def http_get(url, timeout, headers=None, max_bytes=None, with_range=False):
    """GET → (code, body, ttfb_ms, total_ms)。body 最多读 max_bytes。

    HTTP 4xx/5xx 不抛错，作为 (code, ...) 返回——服务端应答属于 L0 判据；
    连接层失败抛 NetworkError（不判死）。ttfb 含建连（urllib 无法单独量 connect）。
    """
    url = normalize_url(url)
    hdrs = dict(headers or {})
    if with_range and max_bytes:
        hdrs["Range"] = "bytes=0-%d" % (max_bytes - 1)
    request = urllib.request.Request(url, headers=hdrs)
    t0 = time.monotonic()
    try:
        with urllib.request.urlopen(request, timeout=timeout,
                                     context=_ssl_context()) as resp:
            ttfb = int((time.monotonic() - t0) * 1000)
            data = resp.read(max_bytes) if max_bytes else resp.read()
            total = int((time.monotonic() - t0) * 1000)
            return resp.status, data, ttfb, total
    except urllib.error.HTTPError as exc:
        total = int((time.monotonic() - t0) * 1000)
        return exc.code, b"", int((time.monotonic() - t0) * 1000), total
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise NetworkError(str(exc)) from exc


def site_id(site):
    """与 aggregate.py 同一规则：优先 key，缺 key 用 name|api。"""
    key = str(site.get("key") or "").strip()
    if key:
        return key
    return "%s|%s" % (site.get("name", ""), site.get("api", ""))


def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def is_official_page(url):
    return any(frag in url for frag in OFFICIAL_PLAYER_HOSTS)


def parse_episode_groups(vod_play_url):
    """照 TvboxRepository.parseEpisodeList：$$$ 分组 → # 分集 → 集名$URL，
    剔除非 http 与官方播放页；优先含 .m3u8 直链的组。返回候选组列表。"""
    groups = []
    for raw_group in str(vod_play_url).split("$$$"):
        episodes = []
        for segment in raw_group.split("#"):
            if "$" not in segment:
                continue
            title, _, url = segment.partition("$")
            title, url = title.strip(), url.strip()
            if url.startswith("http") and not is_official_page(url):
                episodes.append((title or "正片", url))
        if episodes:
            groups.append(episodes)
    if not groups:
        return []
    for group in groups:
        if any(u.split("?")[0].endswith(".m3u8") for _, u in group):
            return [group] + [g for g in groups if g is not group]
    return groups


def extract_m3u8(html):
    """照 TvboxRepository.extractM3u8 三级兜底。"""
    match = CONST_URL_REGEX.search(html)
    if match and match.group(1).strip():
        return match.group(1).strip()
    match = M3U8_URL_REGEX.search(html)
    if match:
        return match.group(0)
    match = RELATIVE_M3U8_REGEX.search(html)
    if match:
        return match.group(1)
    return None


def resolve_line_url(raw_url, timeout, cache):
    """照 TvboxRepository.resolveLineUrl：直链 m3u8 / 红果 main_url / HTML 三级提取。"""
    if raw_url.split("?")[0].endswith(".m3u8"):
        return raw_url
    if raw_url in cache:
        return cache[raw_url]
    if ("://hongguoduanju.com/player/" in raw_url
            or "://www.hongguoduanju.com/player/" in raw_url):
        code, html_bytes, _, _ = http_get(raw_url, timeout)
        if code != 200:
            return None
        match = HONGGUO_MAIN_URL_REGEX.search(
            html_bytes.decode("utf-8", "replace"))
        if not match:
            return None
        url = match.group(1).replace("\\/", "/").replace("\\u002F", "/")
        if not url.startswith("http"):
            return None
        cache[raw_url] = url
        return url
    code, html_bytes, _, _ = http_get(raw_url, timeout)
    if code != 200:
        return None
    extracted = extract_m3u8(html_bytes.decode("utf-8", "replace"))
    if not extracted:
        return None
    resolved = (extracted if extracted.startswith("http")
                else urllib.parse.urljoin(raw_url, extracted))
    cache[raw_url] = resolved
    return resolved


def _playlist_attr(line, attr):
    match = re.search(attr + r'="([^"]+)"', line)
    return match.group(1) if match else None


def probe_play(url, timeout):
    """L3 试播：拉通播放列表 + 首分片实读 256KB（裸头）。
    返回 (ok, bytes, reason)。m3u8 内 AES key 只验证可达，不解密。"""
    is_m3u8 = url.split("?")[0].endswith(".m3u8")
    if not is_m3u8:
        code, data, _, _ = http_get(url, timeout, max_bytes=SEGMENT_BYTES,
                                    with_range=True)
        if code in (200, 206) and data:
            return True, len(data), ""
        return False, 0, "直链分片 HTTP %d" % code

    code, text_bytes, _, _ = http_get(url, timeout, max_bytes=PLAYLIST_BYTES)
    if code not in (200, 206) or not text_bytes:
        return False, 0, "m3u8 HTTP %d" % code
    text = text_bytes.decode("utf-8", "replace")

    # master playlist → 随机挑一条变体（等价播放器自选清晰度）
    if "#EXT-X-STREAM-INF" in text:
        variants = [ln.strip() for ln in text.splitlines()
                    if ln.strip() and not ln.startswith("#")]
        if not variants:
            return False, 0, "master 无变体"
        url = urllib.parse.urljoin(url, random.choice(variants))
        code, text_bytes, _, _ = http_get(url, timeout,
                                          max_bytes=PLAYLIST_BYTES)
        if code not in (200, 206) or not text_bytes:
            return False, 0, "变体播放表 HTTP %d" % code
        text = text_bytes.decode("utf-8", "replace")

    # EXT-X-KEY：可达性验证（不解密）
    for line in text.splitlines():
        if line.startswith("#EXT-X-KEY:") and "METHOD=NONE" not in line:
            key_uri = _playlist_attr(line, "URI")
            if key_uri:
                key_url = urllib.parse.urljoin(url, key_uri)
                code, _, _, _ = http_get(key_url, timeout, max_bytes=64)
                if code not in (200, 206):
                    return False, 0, "key HTTP %d" % code
            break

    # EXT-X-MAP（fMP4 init）：存在则先拉通
    for line in text.splitlines():
        if line.startswith("#EXT-X-MAP:"):
            map_uri = _playlist_attr(line, "URI")
            if map_uri:
                code, data, _, _ = http_get(urllib.parse.urljoin(url, map_uri),
                                            timeout, max_bytes=64 * 1024)
                if code not in (200, 206) or not data:
                    return False, 0, "init 段 HTTP %d" % code
            break

    segments = [ln.strip() for ln in text.splitlines()
                if ln.strip() and not ln.startswith("#")]
    if not segments:
        return False, 0, "播放列表无分片"
    seg_url = urllib.parse.urljoin(url, segments[0])
    code, data, _, total = http_get(seg_url, timeout,
                                    max_bytes=SEGMENT_BYTES, with_range=True)
    if code in (200, 206) and data:
        return True, len(data), ""
    return False, 0, "首分片 HTTP %d" % code


def probe_cms(site, timeout, resolve_cache):
    """type 0/1：本仓库播放方法。返回 (status, level, reason, ttfb, kbps, bytes)。"""
    api = str(site.get("api") or "").rstrip("/")
    word = random.choice(HOTWORDS)
    url = "%s?ac=detail&wd=%s" % (api, urllib.parse.quote(word))
    try:
        code, body, ttfb, _ = http_get(url, timeout)
    except NetworkError as exc:
        return None, 0, "连接层失败: %s" % exc, None, None, None
    if code != 200:
        return "strike", 0, "搜索 HTTP %d" % code, ttfb, None, None
    text = body.decode("utf-8", "replace").lstrip("﻿").strip()
    if not text.startswith("{"):
        return "strike", 0, "非 JSON 应答", ttfb, None, None
    try:
        lst = json.loads(text).get("list") or []
    except ValueError:
        return "strike", 0, "JSON 解析失败", ttfb, None, None
    vods = [v for v in lst if isinstance(v, dict)
            and str(v.get("vod_play_url") or "").strip()]
    if not lst or not vods:
        return "strike", 0, "list 空或无选集", ttfb, None, None

    # L2：随机一条 vod → 选集组（m3u8 组优先）→ 随机一集 → 线路解析
    random.shuffle(vods)
    resolved = None
    all_official = False
    has_http_candidate = False
    for vod in vods[:3]:                      # 最多试 3 条 vod，单条不中不放弃
        groups = parse_episode_groups(vod.get("vod_play_url") or "")
        if not groups:
            # 有 http 选集但全是官方页 → 本仓库口径无货
            segs = str(vod.get("vod_play_url") or "").split("$$$")
            urls = [s.partition("$")[2] for g in segs for s in g.split("#")
                    if "$" in s]
            if any(u.startswith("http") for u in urls):
                all_official = True
            continue
        has_http_candidate = True
        for _ in range(3):                    # 组内随机抽 3 集尝试解析
            _, ep_url = random.choice(random.choice(groups))
            try:
                candidate = resolve_line_url(ep_url, timeout, resolve_cache)
            except NetworkError:
                candidate = None
            if candidate:
                resolved = candidate
                break
        if resolved:
            break
    if resolved is None:
        if all_official and not has_http_candidate:
            return "untestable", 0, "选集全为官方播放页", ttfb, None, None
        return "degraded", 2, "线路解析失败", ttfb, None, None

    # L3 试播（kbps 含播放表取回时间，仅参考档）
    t1 = time.monotonic()
    try:
        ok, nbytes, reason = probe_play(resolved, timeout)
    except NetworkError as exc:
        return None, 2, "连接层失败: %s" % exc, ttfb, None, None
    elapsed = max(0.001, time.monotonic() - t1)
    if not ok:
        return "degraded", 2, reason or "试播失败", ttfb, None, None
    kbps = int(nbytes / 1024 / elapsed)
    return "healthy", 3, "", ttfb, kbps, nbytes


def classify(site):
    """→ 'cms' | 'untestable' | 'skip'（口径：只有本仓库能播的才测）"""
    if int(site.get("searchable", 1) or 0) == 0:
        return "skip"
    if int(site.get("type") or 0) in (0, 1):
        return "cms"
    return "untestable"


def apply_result(old, status, level, reason, ttfb, kbps, nbytes):
    """按状态机更新一条记录（old 可能为 None）。"""
    now = now_iso()
    old = old or {}
    streak = int(old.get("fail_streak") or 0)
    rec = {
        "level": level,
        "status": status,
        "reason": reason,
        "ttfb_ms": ttfb,
        "play_kbps": kbps,
        "bytes": nbytes,
        "fail_streak": streak,
        "last_check": now,
        "last_ok": old.get("last_ok"),
    }
    if status == "healthy":
        rec["fail_streak"] = 0
        rec["last_ok"] = now
    elif status == "strike":
        streak += 1
        rec["status"] = "dead" if streak >= STRIKE_LIMIT else "unknown"
        rec["fail_streak"] = streak
    elif status is None:
        # 连接层失败：不判死不计次，保留原状态
        rec["status"] = old.get("status") or "unknown"
        rec["level"] = int(old.get("level") or level)
    elif status == "untestable":
        rec["last_check"] = old.get("last_check") or now
    return rec


def load_input(spec, timeout):
    if spec.startswith("http://") or spec.startswith("https://"):
        code, body, _, _ = http_get(spec, timeout, max_bytes=8 * 1024 * 1024)
        if code != 200:
            raise SystemExit("拉取订阅失败 HTTP %d: %s" % (code, spec))
        raw = body
    else:
        raw = Path(spec).read_bytes()
    text = raw.decode("utf-8", "replace").lstrip("﻿")
    data = json.loads(text)
    sites = data.get("sites")
    if not isinstance(sites, list):
        raise SystemExit("订阅没有 sites 数组: %s" % spec)
    return sites


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--input", default=DEFAULT_INPUT,
                        help="订阅 JSON：URL 或本地路径（默认仓库 main 的 dist）")
    parser.add_argument("--output", default=DEFAULT_OUTPUT,
                        help="checks.json 输出路径（默认 /etc/tvboxcheck/）")
    parser.add_argument("--limit", type=int, default=0,
                        help="随机抽测 N 个可测站（0=全量）")
    parser.add_argument("--only", default="",
                        help="逗号分隔 key，只测这些站（忽略 limit）")
    parser.add_argument("--concurrency", type=int, default=8)
    parser.add_argument("--timeout", type=int, default=8)
    parser.add_argument("--full", action="store_true",
                        help="忽略 6 小时新鲜度，全部重测")
    args = parser.parse_args()

    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(encoding="utf-8", errors="replace")
            sys.stderr.reconfigure(encoding="utf-8", errors="replace")
        except (ValueError, OSError):
            pass

    sites = load_input(args.input, args.timeout)

    checks = {}
    out_path = Path(args.output)
    if out_path.exists():
        try:
            loaded = json.loads(out_path.read_text(encoding="utf-8"))
            if isinstance(loaded, dict):
                checks = loaded
        except ValueError:
            print("[!] 旧 checks.json 解析失败，将整体重建", file=sys.stderr)

    probeable, untestable = [], []
    only = {k.strip() for k in args.only.split(",") if k.strip()}
    now_ms = time.time() * 1000
    for site in sites:
        kind = classify(site)
        sid = site_id(site)
        if kind == "skip":
            continue
        if kind == "untestable":
            untestable.append((sid, site))
            continue
        if only and sid not in only:
            continue
        old = checks.get(sid) or {}
        last = old.get("last_check")
        # --only 是调试用强制重测：不套 6 小时新鲜度
        if not args.full and not only and last:
            try:
                ts = datetime.fromisoformat(last).timestamp() * 1000
                if now_ms - ts < FRESH_MS and old.get("status") in (
                        "healthy", "degraded", "unknown", "dead", "untestable"):
                    continue
            except ValueError:
                pass
        probeable.append((sid, site, kind))

    if args.limit and len(probeable) > args.limit:
        probeable = random.sample(probeable, args.limit)

    # 不测的类型也记档（LuCI 状态表要显示 untestable）
    for sid, site in untestable:
        old = checks.get(sid)
        if old is None or old.get("status") != "untestable":
            checks[sid] = apply_result(
                old, "untestable", 0,
                "本仓库 TVBox 模块不可播(type=%s)" % site.get("type"),
                None, None, None)

    resolve_cache = {}
    done = {"n": 0, "total": len(probeable)}

    def run_one(sid, site):
        # 单站异常不拖垮整轮：记 sid+堆栈到日志后返回 None（无记录但计入进度）
        try:
            status, level, reason, ttfb, kbps, nbytes = probe_cms(
                site, args.timeout, resolve_cache)
        except Exception:
            print("[!] 内部错误 sid=%s: %s"
                  % (sid, traceback.format_exc(limit=4)),
                  file=sys.stderr, flush=True)
            return sid, None
        return sid, apply_result(checks.get(sid), status, level, reason,
                                 ttfb, kbps, nbytes)

    print("探测开始: 可测 %d, untestable %d, 并发 %d"
          % (len(probeable), len(untestable), args.concurrency), flush=True)
    with ThreadPoolExecutor(max_workers=args.concurrency) as pool:
        futures = [pool.submit(run_one, sid, site)
                   for sid, site, kind in probeable]
        for future in as_completed(futures):
            try:
                sid, rec = future.result()
            except Exception as exc:            # 兜底：apply_result 级异常
                print("[!] 内部错误: %s" % exc, file=sys.stderr, flush=True)
                done["n"] += 1
                continue
            done["n"] += 1
            if rec is None:
                continue
            checks[sid] = rec
            print("[%d/%d] %-28s %-10s L%s %s"
                  % (done["n"], done["total"], sid[:28], rec["status"],
                     rec["level"], rec["reason"]), flush=True)

    out_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = out_path.with_suffix(out_path.suffix + ".tmp")
    tmp.write_text(json.dumps(checks, ensure_ascii=False, indent=2) + "\n",
                   encoding="utf-8")
    tmp.replace(out_path)

    tally = {}
    for rec in checks.values():
        st = rec.get("status", "?")
        tally[st] = tally.get(st, 0) + 1
    print("完成: 本轮 %d 站, 输出 %s" % (done["n"], out_path), flush=True)
    print("全量状态: " + ", ".join("%s=%d" % kv for kv in sorted(tally.items())))
    return 0


if __name__ == "__main__":
    sys.exit(main())
